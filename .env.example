# AI Social configuration.
# The start script creates .env from this file and fills in APP_SECRET.
# Everything else is optional: AI keys and social accounts are added from
# the browser (Setup / Settings), so most people never edit this file.

# Encryption key for stored API keys and tokens. Keep it private.
# Do not change it after setup, or saved keys can no longer be decrypted.
APP_SECRET=

# --- Web server ---------------------------------------------------------
# AISOCIAL_HOST=127.0.0.1
# AISOCIAL_PORT=5050
# Public address used in OAuth redirects (LinkedIn).
# Default: http://localhost:<port>
# AISOCIAL_PUBLIC_URL=http://localhost:5050
# Required when AISOCIAL_HOST is not 127.0.0.1 (for example 0.0.0.0):
# AISOCIAL_PASSWORD=

# --- AI (optional: values here override the keys saved in the app) -----
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Text provider: auto, anthropic or openai
# AI_TEXT_PROVIDER=auto
# ANTHROPIC_MODEL=claude-opus-5-5
# Effort: low, medium or high
# ANTHROPIC_EFFORT=low
# OPENAI_TEXT_MODEL=gpt-5-mini
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Advanced -------------------------------------------------------------
# LinkedIn API version (YYYYMM). Default: picked automatically.
# LINKEDIN_API_VERSION=
# FACEBOOK_GRAPH_VERSION=v26.0
# AISOCIAL_DB_PATH=instance/aisocial.db
# AISOCIAL_SCHEDULER_INTERVAL=15
# AISOCIAL_MAX_LATE_MINUTES=360
